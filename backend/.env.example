# Copy to backend/.env for a local FastAPI process outside Docker.
# Set separate, unique passwords before starting the backend.

# === Database ===
# DB_USER is the least-privilege application role (NOSUPERUSER, NOBYPASSRLS).
# DB_ADMIN_USER is only used for Alembic migrations and role bootstrap.
# They MUST be different: the service refuses to start otherwise, because the
# application must never run with a role that can bypass row-level security.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ttcs_db
DB_USER=ttcs_app
DB_PASSWORD=replace-with-app-database-password
DB_ADMIN_USER=admin
DB_ADMIN_PASSWORD=replace-with-database-admin-password
# Connection pooling
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=300

# === Application ===
APP_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters
DEBUG=False
# Comma-separated exact origins. A wildcard is rejected: the API sends
# credentialed cookies, so "*" would turn CORS into an open door.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# === Sessions ===
SESSION_TTL_MINUTES=480
# The __Host- prefix requires Secure + Path=/ and forbids Domain.
# Must stay true outside development; the service refuses to start otherwise.
SESSION_COOKIE_NAME=__Host-session
SESSION_COOKIE_SECURE=True
# "none" requires SESSION_COOKIE_SECURE=True and is only needed when the
# frontend and backend sit on genuinely different sites.
SESSION_COOKIE_SAMESITE=lax
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

DEMO_ADMIN_EMAIL=admin@gmail.com
DEMO_ADMIN_PASSWORD=replace-with-a-unique-long-password
SYSTEM_ADMIN_EMAIL=admin@ttcs.local
SYSTEM_ADMIN_PASSWORD=replace-with-another-unique-long-password
