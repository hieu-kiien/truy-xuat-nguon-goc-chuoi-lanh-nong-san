# Copy to backend/.env and replace both passwords before running the API.

# === Database roles ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ttcs_db
DB_USER=ttcs_app
DB_PASSWORD=replace-with-application-role-password
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=replace-with-migration-role-password

# Optional full URLs. DATABASE_URL_ENV must connect as DB_USER.
# MIGRATION_DATABASE_URL_ENV may be set when migrations use a separate host.
# DATABASE_URL_ENV=postgresql+psycopg://ttcs_app:password@host:5432/ttcs_db
# MIGRATION_DATABASE_URL_ENV=postgresql+psycopg://postgres:password@host:5432/ttcs_db

# === Application ===
APP_ENV=development
SESSION_TTL_MINUTES=480
SESSION_COOKIE_NAME=__Host-session
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
