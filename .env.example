# Copy this file to .env before running docker compose.
DB_HOST=database
DB_PORT=5432
DB_NAME=ttcs_db
DB_USER=ttcs_app
DB_PASSWORD=replace-with-local-application-role-password
DB_ADMIN_USER=admin
DB_ADMIN_PASSWORD=replace-with-local-migration-role-password
APP_ENV=development
DEBUG=true
DEMO_PASSWORD=Password123!
LOGIN_LOCK_MINUTES=15
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Trang truy xuất công khai (S-48/S-49/S-50) — để trống nếu dùng giá trị mặc định
# PUBLIC_TRACE_CACHE_TTL_SECONDS=60
# PUBLIC_TRACE_RATE_LIMIT_CODES=30
# PUBLIC_TRACE_RATE_WINDOW_SECONDS=60

