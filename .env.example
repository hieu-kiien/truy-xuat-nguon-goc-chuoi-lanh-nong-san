# Copy this file to .env. Keep the database passwords private.
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-secret
APP_DB_PASSWORD=replace-with-a-different-long-random-secret
SECRET_KEY=replace-with-at-least-32-random-characters

# Local development accounts. Use unique passwords of at least 12 characters.
DEMO_ADMIN_EMAIL=admin@gmail.com
DEMO_ADMIN_PASSWORD=replace-with-a-unique-long-password
SYSTEM_ADMIN_EMAIL=admin@ttcs.local
SYSTEM_ADMIN_PASSWORD=replace-with-another-unique-long-password
