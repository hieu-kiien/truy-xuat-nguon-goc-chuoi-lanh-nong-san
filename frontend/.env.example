# Sao chép file này thành .env.local và điền giá trị của bạn
# cp .env.example .env.local
# KHÔNG commit file .env.local lên Git!

# URL của Backend API
VITE_API_BASE_URL=http://localhost:8000

# Chỉ bật khi backend cũng có ENABLE_DEMO_LOGIN=true.
# Không chứa bí mật; đây chỉ là cờ để hiện nút demo trên giao diện.
VITE_ENABLE_DEMO_LOGIN=false
